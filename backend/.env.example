# Non-secret config only. AWS credentials come from your AWS CLI profile locally and the Lambda role in AWS.
# Region where Claude Sonnet 5 model access is approved in Bedrock.
AWS_REGION=us-west-2
AWS_PROFILE=finlife
# Copy model IDs from the Bedrock console. Do not guess them.
BEDROCK_MODEL_ID=
BEDROCK_FALLBACK_MODEL_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=
# Leave blank locally to use backend/.local instead of DynamoDB.
BRIEFS_TABLE=
AUDIT_TABLE=
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# 1 = canned coach replies, no Bedrock calls.
FINLIFE_STUB_AI=1
FINLIFE_LOCAL_DIR=.local
