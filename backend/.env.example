# Non-secret config only. Never put AWS keys here: locally they are the hackathon's temporary keys in the
# "finlife" AWS CLI profile (see "AWS account" in the team prompts); in AWS, the Lambda role.
# The hackathon's event region, where the Claude models are enabled.
AWS_REGION=us-west-2
AWS_PROFILE=finlife
# Copy model IDs from the Bedrock console. Do not guess them.
BEDROCK_MODEL_ID=
BEDROCK_FALLBACK_MODEL_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=
# Leave blank locally to use backend/.local instead of DynamoDB.
BRIEFS_TABLE=
AUDIT_TABLE=
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# 1 = canned coach replies, no Bedrock calls.
FINLIFE_STUB_AI=1
FINLIFE_LOCAL_DIR=.local
